{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/laverssiera/liceu-genome/schema/genome.schema.json",
  "title": "LICEU 6.0 — Genoma",
  "description": "Um único grafo tipado. Cada nó tem um 'kind'. As arestas são campos que referenciam ids de outros nós, e o validador as resolve. Regras de desenho: (1) o status de uma afirmação é DERIVADO das provas e não pode ser declarado; (2) cada dimensão de estado tem uma única definição (C6-SM-01); (3) a tela só exibe o que declara (whitelist, fail-closed); (4) a validade mora no nó de conhecimento, e não no link: o link declara o USO, e o validador faz a junção.",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo"
      ],
      "properties": {
        "repo": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "pr": {
          "type": "integer"
        },
        "issue": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "use": {
      "enum": [
        "exploration",
        "design_reference",
        "research",
        "comparison_as_proposal",
        "authoritative_decision",
        "authoritative_budget",
        "procurement_commitment",
        "physical_execution_authorization"
      ]
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "graph_version",
        "chain_positions"
      ],
      "properties": {
        "id": {
          "const": "genome"
        },
        "kind": {
          "const": "meta"
        },
        "title": {
          "type": "string"
        },
        "graph_version": {
          "type": "string",
          "description": "Versão do grafo causal em vigor. Toda contagem é relativa a ele."
        },
        "chain_positions": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        },
        "shadow_mode_ceiling": {
          "type": "integer",
          "minimum": 1,
          "description": "Teto da cadeia em MODO SOMBRA: a ultima posicao que e ato do LICEU. Acima dele os atos sao do mundo real e entram como observacao, nunca como fato de autoridade. O juiz mostra o teto em vez de fingir que faltam elos."
        },
        "shadow_mode_note": {
          "type": "string"
        }
      }
    },
    "monolith": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "plane"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^liceu\\.[a-z]+$"
        },
        "kind": {
          "const": "monolith"
        },
        "title": {
          "type": "string"
        },
        "plane": {
          "enum": [
            "Protocolo",
            "Perception",
            "Cognition",
            "Authority",
            "Reality",
            "Feedback"
          ]
        },
        "repo": {
          "type": "string"
        },
        "may_authorize": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "may_decide": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teto_interno": {
          "enum": [
            "LOCAL",
            "REGIONAL",
            "CONTINENTAL",
            "GLOBAL",
            "CIVILIZACIONAL",
            "INTERPLANETARIA"
          ]
        },
        "field_provenance": {
          "type": "object",
          "description": "Origem de cada campo RELATADO: derived (extraido de fonte verificavel — kit, events, codigo — e conferivel pelo juiz) ou asserted (escrito por humano ou IA). Campo asserted nao sustenta PROVEN nem entra na contagem da cadeia; sustenta divida e alerta (FIT-013).",
          "additionalProperties": {
            "enum": [
              "derived",
              "asserted"
            ]
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "values",
        "defined_by"
      ],
      "description": "Uma dimensão de estado do C6-SM-01. Um valor pertence a UMA dimensão só.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "kind": {
          "const": "dimension"
        },
        "title": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          }
        },
        "defined_by": {
          "type": "string",
          "description": "Contrato, ou 'genome' para dimensões internas deste grafo."
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "producer",
        "in_registry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^liceu\\.[a-z]+\\.[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "kind": {
          "const": "contract"
        },
        "title": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "in_registry": {
          "type": "boolean",
          "description": "Se o contrato existe no Contract Registry do kit, ou só num ADR."
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "DEPRECATED",
            "RETIRED"
          ]
        },
        "chain_position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "0 = entrada; 1..N = elo posicionado da cadeia causal."
        },
        "carries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emitters_observed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Produtores observados emitindo este evento no código."
        },
        "implementation_observed": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Valores de dimensão que o código de fato produz."
        },
        "superseded_by": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "field_provenance": {
          "type": "object",
          "description": "Origem de cada campo RELATADO: derived (extraido de fonte verificavel — kit, events, codigo — e conferivel pelo juiz) ou asserted (escrito por humano ou IA). Campo asserted nao sustenta PROVEN nem entra na contagem da cadeia; sustenta divida e alerta (FIT-013).",
          "additionalProperties": {
            "enum": [
              "derived",
              "asserted"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "in_registry": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "lifecycle"
            ]
          },
          "else": {
            "not": {
              "required": [
                "lifecycle"
              ]
            }
          }
        }
      ]
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "knowledge_type",
        "validity",
        "permitted_uses",
        "prohibited_uses",
        "source"
      ],
      "description": "Mesmo invariante da tabela de atribuições do BIM: VIGENTE exige dono e revisor; PROPOSTA não pode ter dono.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]+$"
        },
        "kind": {
          "const": "knowledge"
        },
        "title": {
          "type": "string"
        },
        "knowledge_type": {
          "enum": [
            "persona",
            "stakeholder",
            "journey",
            "ips",
            "cqp",
            "cqm",
            "price",
            "norm",
            "supplier",
            "professional"
          ]
        },
        "validity": {
          "enum": [
            "PROPOSTA",
            "VIGENTE"
          ]
        },
        "owner": {
          "type": "string"
        },
        "reviewed_by": {
          "type": "string"
        },
        "permitted_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/use"
          }
        },
        "prohibited_uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/use"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validity": {
                "const": "VIGENTE"
              }
            }
          },
          "then": {
            "required": [
              "owner",
              "reviewed_by"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "owner"
                  ]
                },
                {
                  "required": [
                    "reviewed_by"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "used_as"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "used_as": {
          "$ref": "#/$defs/use"
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "journey",
        "used_by",
        "owner_monolith",
        "reads",
        "john_participation",
        "displays",
        "must_not_display",
        "evidence_required",
        "confidence_display",
        "ips_supported",
        "implementation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SCR-[0-9]{2}$"
        },
        "kind": {
          "const": "screen"
        },
        "title": {
          "type": "string"
        },
        "journey": {
          "type": "string"
        },
        "used_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "owner_monolith": {
          "type": "string"
        },
        "reads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "john_participation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "john",
              "role"
            ],
            "properties": {
              "john": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "RECOMMENDS",
                  "SYNTHESIZES",
                  "OBSERVES"
                ],
                "description": "AUTHORIZES e EXECUTES não existem: impossível até de escrever."
              }
            }
          }
        },
        "displays": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "WHITELIST por dimensão. O que não está aqui a tela não exibe."
        },
        "shows_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_display": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_display": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+(:[A-Z_]+)?$"
          }
        },
        "evidence_required": {
          "type": "boolean"
        },
        "confidence_display": {
          "enum": [
            "never",
            "only_with_method"
          ]
        },
        "ips_supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "ips_gap": {
          "type": "string"
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_IMPLEMENTED",
                "PARTIAL",
                "IMPLEMENTED"
              ]
            },
            "path": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ips_supported": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "required": [
              "ips_gap"
            ]
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "asserted_by"
      ],
      "description": "NÃO há campo de status. O status é derivado das provas: declarar é inválido.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CLM-[A-Z0-9-]+$"
        },
        "kind": {
          "const": "claim"
        },
        "statement": {
          "type": "string"
        },
        "asserted_by": {
          "type": "string"
        },
        "chain_link": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "measure"
          ],
          "properties": {
            "position": {
              "type": "integer",
              "minimum": 0
            },
            "measure": {
              "enum": [
                "structural",
                "substantive"
              ]
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prediction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "registered_at",
            "method",
            "method_version",
            "settled_by"
          ],
          "description": "Pre-registro: esta afirmacao foi feita ANTES de o mundo real responder. Quem a resolve e observacao externa, nunca teste, e a prova tem de ser POSTERIOR ao registro — previsao registrada depois do fato nao e previsao (FIT-016).",
          "properties": {
            "registered_at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "Data do pre-registro. E a data a partir da qual a previsao vale; prova anterior a ela nao a confirma."
            },
            "method": {
              "type": "string",
              "description": "Metodo que a produziu, sem a versao."
            },
            "method_version": {
              "type": "string",
              "description": "Versao do metodo."
            },
            "basis": {
              "type": "string",
              "description": "A base de que saiu (perfil normativo, grafo)."
            },
            "derived_from": {
              "type": "string",
              "description": "O que na base a sustenta."
            },
            "settled_by": {
              "type": "string",
              "description": "O ato real que a confirma ou refuta. Sem oraculo declarado, a previsao nao se refuta — e nao vale."
            }
          }
        },
        "classe": {
          "enum": [
            "NORMA",
            "VERIFICACAO"
          ],
          "description": "A CLASSE DA AFIRMACAO, e ela decide o que RESOLVE a claim. NORMA: o que a norma EXIGE -- resolve-se lendo a norma, e o orgao nao tem voto sobre isso. VERIFICACAO: o que a instituicao DE FATO verifica -- resolve-se por observacao externa, e a norma nao tem voto sobre isso. POR QUE O CAMPO EXISTE: em 2026-10-19 a primeira exigencia da Prefeitura sobre a P-001 pediu duas pecas e nao mencionou nem os indices urbanisticos nem a declaracao condominial. A tentacao que isso cria e precisa -- na proxima vez, nao apontar o que o orgao nao aponta, calibrando o metodo pela diligencia de quem fiscaliza. Ausencia de exigencia NAO e evidencia de conformidade. O QUE O CAMPO NAO E: nao e a classe NORMA do portao C25-06, que classifica CHAVES de declaracao em artefatos governados e tem 44 membros. Esta classifica CLAIMS, e as duas listas nao se tocam. AUSENTE E INSUFICIENCIA DECLARADA, nao ma-formacao: claim sem classe fica fora do portao da nao-propagacao, e o juiz CONTA e NOMEIA quantas sao, pela mesma razao por que o `scope` ausente vira INDETERMINADO em vez de matar a validacao."
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "basis",
        "date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRF-[0-9]{4}$"
        },
        "kind": {
          "const": "proof"
        },
        "title": {
          "type": "string"
        },
        "proves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "refutes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "enum": [
            "test",
            "external_observation",
            "code_reading",
            "record_reading"
          ]
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "path"
          ],
          "properties": {
            "repo": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "pr": {
              "type": "integer"
            }
          }
        },
        "external_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instrument",
            "observed"
          ],
          "properties": {
            "instrument": {
              "type": "string"
            },
            "observed": {
              "type": "string"
            },
            "ato_de_terceiro": {
              "type": "string",
              "minLength": 1,
              "description": "QUEM praticou o ato, e quando — preenchido SO quando a observacao registra ato de terceiro que nos apenas RECEBEMOS, e nao instrumento nosso rodado contra sistema externo. A distincao nao e derivavel e foi medida: das 42 provas por observacao externa, 8 tem environment=durable e so DUAS sao o mundo agindo; as outras seis somos nos rodando conector do Drive, gh api, sonda HTTP ou lendo documentacao. Por isso o campo e STRING e nao booleano: `true` nao diz quem nem quando, e a UNK-0018 exige data e procedencia de todo registro nao derivavel. PARA QUE SERVE: separar 'ato de terceiro RECEBIDO' de 'previsao pre-registrada RESPONDIDA'. Sao quantidades diferentes e foram colapsadas uma vez, no corpo do PR 129 — a secao chamava-se 'A primeira resposta do mundo real ao modo sombra' e o rodape dizia '4 previsoes / 4 sem resposta'. O mundo agir NAO move o modo sombra; so o ato que a previsao declara em settled_by move."
            }
          }
        },
        "evidence_artifact": {
          "$ref": "#/$defs/source"
        },
        "location": {
          "$ref": "#/$defs/source"
        },
        "environment": {
          "enum": [
            "local",
            "ci",
            "ephemeral",
            "durable"
          ]
        },
        "commit": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data da observacao, em YYYY-MM-DD. A forma e exigida porque TODA comparacao de data no juiz e comparacao de texto: '2026-9-30' e maior que '2026-09-30' para o computador e menor para o calendario."
        },
        "supersedes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^PRF-[0-9]{4}$"
          },
          "description": "Provas cuja validade ESTA prova encerra. A prova superseded fica no grafo (historia); so as vigentes — as que nenhuma outra supersede — entram na derivacao."
        },
        "scale": {
          "type": "string",
          "description": "Escala do FATO observado (enum federativo da Constituicao, lido do kit). Obrigatoria quando a prova sustenta um elo da cadeia: a contagem e POR ESCALA e um elo provado numa escala bloqueada nao conta naquela escala (FIT-011)."
        },
        "mechanism": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "paths",
            "content_hash",
            "commit"
          ],
          "description": "A SUPERFICIE que esta prova cobre, com precisao de arquivo. Quando ela muda, a prova precisa ser feita de novo — a CI do proprio monolito acusa (tools/genome_surface_check.py). Superficie de repositorio inteiro e proibida: ficaria obsoleta a cada commit, o genoma viraria ruido e as pessoas o ignorariam.",
          "properties": {
            "repo": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 3
              },
              "description": "Arquivos, nunca diretorios nem curingas."
            },
            "content_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "sha256 de (caminho + conteudo LF) de cada arquivo, em ordem."
            },
            "commit": {
              "type": "string",
              "minLength": 7
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "padrao",
            "universo",
            "excluidos",
            "instrumento"
          ],
          "description": "COBERTURA DECLARADA DA BUSCA (FIT-019), para prova de leitura. Afirmacao negativa — 'nada le este campo', 'nao existe tal chamada' — so vale com o escopo que ACHARIA o contrario; sem ele a prova mede o que o autor olhou, nao o que existe. POR QUE NAO ESTA EM required AQUI, e e deliberado: scope ausente e INSUFICIENCIA DECLARADA, nao ma-formacao — vira veredito INDETERMINADO na FIT-019 e a prova continua no grafo como historia. Exigir aqui mataria o juiz na validacao, antes de qualquer veredito, nas 40 provas que antecedem o instrumento; e a lista de isencao teria de ser escrita DUAS vezes, aqui e na fitness, que e a objecao do ADR-002 e a regra de classe de 2026-10-09. O schema exige a FORMA: scope escrito pela metade e erro duro, porque meio escopo engana mais que escopo nenhum.",
          "properties": {
            "padrao": {
              "type": "string",
              "minLength": 1,
              "description": "A expressao buscada, literal, como foi passada ao instrumento."
            },
            "universo": {
              "type": "string",
              "minLength": 1,
              "description": "Onde se buscou, com precisao bastante para repetir: repositorios, refs, extensoes."
            },
            "excluidos": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "O que ficou FORA do universo, e por que. Vazio nao e permitido: 'nada foi excluido' se escreve — 'nenhum: o universo e exaustivo' — porque array vazio nao se distingue de quem nao pensou no assunto."
            },
            "instrumento": {
              "type": "string",
              "minLength": 1,
              "description": "O comando que produziu o resultado, repetivel por outra pessoa."
            }
          }
        },
        "expires_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data (YYYY-MM-DD) a partir da qual a evidencia deixa de sustentar a afirmacao. Vencida -> STALE, nunca REFUTED: 'precisa ser provado de novo', nao 'e falso'."
        },
        "derived_from": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._@:-]+\\.[a-z_]+$"
          },
          "description": "Campos do genoma que esta prova usa como base, no formato <no>.<campo>. Prova que PROVA nao pode se apoiar em campo asserted (FIT-013); prova que REFUTA pode — relato basta para levantar suspeita, nunca para dar certeza."
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "proves"
              ]
            },
            {
              "required": [
                "refutes"
              ]
            }
          ]
        },
        {
          "if": {
            "required": [
              "proves"
            ]
          },
          "then": {
            "properties": {
              "basis": {
                "enum": [
                  "test",
                  "external_observation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "test"
              }
            }
          },
          "then": {
            "required": [
              "test"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "external_observation"
              }
            }
          },
          "then": {
            "required": [
              "external_observation",
              "evidence_artifact",
              "environment"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "code_reading",
                  "record_reading"
                ]
              }
            }
          },
          "then": {
            "required": [
              "location"
            ]
          }
        }
      ],
      "description": "Prova com tempo: refuta ou prova o codigo de um commit. Quando o codigo muda, uma prova nova SUPERSEDE a antiga em vez de apaga-la. Prova apagada e historia reescrita."
    },
    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "evaluated_by"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FIT-[0-9]{3}$"
        },
        "kind": {
          "const": "fitness"
        },
        "statement": {
          "type": "string"
        },
        "evaluated_by": {
          "enum": [
            "genome",
            "runtime"
          ]
        },
        "check": {
          "type": "string"
        },
        "instrument_introduced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "proofs",
            "note"
          ],
          "description": "LISTA FECHADA das provas que ESTA fitness rebaixou no dia em que passou a existir. Serve a uma coisa so: separar, no relatorio e na catraca, o rebaixamento causado pelo INSTRUMENTO NOVO do rebaixamento causado por REGRESSAO. POR QUE LISTA DE IDS E NAO PREDICADO DE DATA: um criterio como 'prova anterior a tal data' isenta qualquer prova retrodatada, e uma regressao real que caia na mesma fitness no mesmo dia fica indistinguivel de um rebaixamento por instrumento — o rebaixamento tem a MESMA FORMA nos dois casos. A lista de ids nao tem esse furo: prova NOVA nasce fora dela, prova EDITADA nao ganha isencao, e a lista so encurta. O lacre e um teste — o sha256 da lista ordenada esta congelado em tools/test_genome_check.py, e acrescentar um id reprova a CI antes de isentar coisa alguma.",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "proofs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^PRF-[0-9]{4}$"
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        "claim": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluated_by": {
                "const": "genome"
              }
            }
          },
          "then": {
            "required": [
              "check"
            ]
          },
          "else": {
            "required": [
              "claim"
            ]
          }
        }
      ]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "question",
        "why_unknown",
        "required_evidence",
        "owner",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UNK-[0-9]{4}$"
        },
        "kind": {
          "const": "unknown"
        },
        "question": {
          "type": "string"
        },
        "why_unknown": {
          "type": "string"
        },
        "required_evidence": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "fitness",
        "detection",
        "observed",
        "tracked_in"
      ],
      "description": "Dívida conhecida. Catraca: violação nova falha; dívida que sumiu também falha.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^VIO-[0-9]{4}$"
        },
        "kind": {
          "const": "violation"
        },
        "fitness": {
          "type": "string"
        },
        "detection": {
          "enum": [
            "genome",
            "code"
          ]
        },
        "subject": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/source"
        },
        "tracked_in": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "detection": {
                "const": "genome"
              }
            }
          },
          "then": {
            "required": [
              "subject"
            ]
          }
        }
      ]
    },
    "pfc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "false_claim",
        "mechanism",
        "regression_tests",
        "date"
      ],
      "description": "Falsa afirmacao evitada. So conta com TESTE DE REGRESSAO executavel, que falharia sem o mecanismo — e o juiz confere que o teste existe no arquivo. PFC sem teste real e asserted: nao entra na contagem (FIT-014).",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FC-[0-9]{3}$"
        },
        "kind": {
          "const": "pfc"
        },
        "title": {
          "type": "string"
        },
        "false_claim": {
          "type": "string",
          "description": "O que teria sido afirmado, e nao foi."
        },
        "mechanism": {
          "type": "string",
          "description": "O que impede — fitness, regra do juiz, detector."
        },
        "regression_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "name"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "repo": {
                "type": "string",
                "description": "Repositorio onde o teste mora, quando nao e o proprio genoma. O juiz nao abre arquivo de outro repositorio: a conferencia acontece na CI daquele repositorio (tools/genome_pfc_check.py), e o repo tem de ser um que o genoma ja prove superficie (FIT-014)."
              }
            }
          }
        },
        "observed": {
          "type": "string",
          "description": "Onde a falsa afirmacao chegou a ser feita, se chegou."
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data da observacao, em YYYY-MM-DD. A forma e exigida porque TODA comparacao de data no juiz e comparacao de texto: '2026-9-30' e maior que '2026-09-30' para o computador e menor para o calendario."
        }
      }
    }
